# Copy to .env (cp .env.example .env). Values here are for LOCAL DEVELOPMENT ONLY.
POSTGRES_USER=ticketdesk
POSTGRES_PASSWORD=ticketdesk
POSTGRES_DB=ticketdesk

# Signs login tokens. Generate your own for anything beyond local dev: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-this-is-not-for-production

# Production only (set these in the hosting dashboard, not here):
#   ENVIRONMENT=production        refuses to start with the dev SECRET_KEY above
#   CORS_ORIGINS=https://your-site.pages.dev   browser origins allowed to call the API
#   DATABASE_URL=postgresql://...  a plain postgresql:// URL is accepted
